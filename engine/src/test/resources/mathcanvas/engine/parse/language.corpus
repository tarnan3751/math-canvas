# §8.2 Lambdas
x -> x^2 ⇒ x -> x^2
(x, y) -> x + y ⇒ (x, y) -> x + y
x -> y -> x + y ⇒ x -> (y -> x + y)
f := x -> x^2 ⇒ f := x -> x^2
f := x -> x^2\nf(2) ⇒ f := x -> x^2 | f(2)
