i -> i^2 ⇒ i -> i^2
pi -> 1 ⇒ error 1:1: `pi` is a constant

# §8.3 Definitions
a := 5 ⇒ a := 5
f(x) := x^2 + 1 ⇒ f(x) := x^2 + 1
f() := 1 ⇒ error 1:3: expected distinct parameter names
f(x, x) := 1 ⇒ error 1:6: expected distinct parameter names
f(2) := 1 ⇒ error 1:3: expected distinct parameter names
(a := 5) ⇒ error 1:4: `:=` defines at statement level only
solve(a := 1, a) ⇒ error 1:9: `:=` defines at statement level only
x -> a := x ⇒ error 1:8: `:=` defines at statement level only
e := 3 ⇒ error 1:1: `e` is a constant
sin := 2 ⇒ error 1:1: `sin` is a builtin
if := 1 ⇒ error 1:1: `if` is reserved
π := 3 ⇒ error 1:1: `π` is a constant
ℤ := 1 ⇒ error 1:1: `ℤ` is a domain
Reals := 1 ⇒ error 1:1: `Reals` is a domain
lim := 1 ⇒ error 1:1: `lim` is reserved
f(e) := e + 1 ⇒ f(e) := e + 1
f(x) := x f(x - 1) ⇒ f(x) := x*f(x - 1)
f := x -> x f(x - 1) ⇒ f := x -> x*f(x - 1)
g(x) := f(x) + 1 ⇒ g(x) := f*x + 1
f(t) := t^2\ng(x) := f(x)\nf := 3\nf(2) ⇒ f(t) := t^2 | g(x) := f(x) | f := 3 | f*2
f(t) := t^2\nclear(f)\nf(2) ⇒ f(t) := t^2 | clear(f) | f*2

