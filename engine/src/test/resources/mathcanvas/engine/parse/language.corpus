lim[x → a-] f ⇒ limit(f, x, a, left)
Σ[k = a, b] f ⇒ sum(f, k, a, b)
sum[k = a, b] f ⇒ sum(f, k, a, b)
Π[k = a, b] f ⇒ product(f, k, a, b)
product[k = a, b] f ⇒ product(f, k, a, b)
|x| ⇒ abs(x)
